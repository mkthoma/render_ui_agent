{
  "root": "root",
  "components": [
    {
      "id": "root",
      "type": "Column",
      "children": [
        "gallery_title",
        "sec_layout",
        "sec_content",
        "sec_input",
        "sec_navigation",
        "sec_charts_and_data",
        "sec_action",
        "sec_provenance_(session_14)"
      ]
    },
    {
      "id": "gallery_title",
      "type": "Text",
      "variant": "heading",
      "text": {
        "$bind": "/title"
      }
    },
    {
      "id": "lay_a",
      "type": "Text",
      "variant": "caption",
      "text": {
        "$bind": "/body"
      }
    },
    {
      "id": "lay_b",
      "type": "Text",
      "variant": "caption",
      "text": {
        "$bind": "/subtitle"
      }
    },
    {
      "id": "g_row",
      "type": "Row",
      "align": "center",
      "justify": "spaceBetween",
      "children": [
        "lay_a",
        "lay_b"
      ]
    },
    {
      "id": "lay_c",
      "type": "Text",
      "variant": "caption",
      "text": {
        "$bind": "/body"
      }
    },
    {
      "id": "g_col",
      "type": "Column",
      "children": [
        "lay_c"
      ]
    },
    {
      "id": "lay_d",
      "type": "Text",
      "variant": "caption",
      "text": {
        "$bind": "/subtitle"
      }
    },
    {
      "id": "g_list",
      "type": "List",
      "children": [
        "lay_d"
      ]
    },
    {
      "id": "lay_e",
      "type": "Text",
      "variant": "caption",
      "text": {
        "$bind": "/body"
      }
    },
    {
      "id": "g_card",
      "type": "Card",
      "title": "Card \u2014 a titled box",
      "children": [
        "lay_e"
      ]
    },
    {
      "id": "g_divider",
      "type": "Divider"
    },
    {
      "id": "g_heading",
      "type": "Text",
      "variant": "heading",
      "text": {
        "$bind": "/title"
      }
    },
    {
      "id": "g_body",
      "type": "Text",
      "variant": "body",
      "text": {
        "$bind": "/body"
      }
    },
    {
      "id": "g_image",
      "type": "Image",
      "alt": "placeholder \u2014 no src, so nothing is fetched"
    },
    {
      "id": "g_notice",
      "type": "Notice",
      "text": {
        "$bind": "/notice_warn"
      },
      "tone": "warn"
    },
    {
      "id": "g_textfield",
      "type": "TextField",
      "label": "Query",
      "value": {
        "$bind": "/query"
      },
      "placeholder": "search\u2026"
    },
    {
      "id": "g_checkbox",
      "type": "CheckBox",
      "label": "Only peer-reviewed sources",
      "checked": {
        "$bind": "/only_peer_reviewed"
      }
    },
    {
      "id": "g_slider",
      "type": "Slider",
      "label": "Max sources",
      "value": {
        "$bind": "/max_sources"
      },
      "min": 1,
      "max": 10
    },
    {
      "id": "g_choice",
      "type": "InputChoice",
      "label": "Model",
      "options": {
        "$bind": "/model_options"
      },
      "value": {
        "$bind": "/model_choice"
      }
    },
    {
      "id": "g_datetime",
      "type": "DateTime",
      "label": "Run after",
      "value": {
        "$bind": "/run_after"
      }
    },
    {
      "id": "tab_a",
      "type": "Text",
      "variant": "body",
      "text": {
        "$bind": "/body"
      }
    },
    {
      "id": "tab_b",
      "type": "Text",
      "variant": "body",
      "text": {
        "$bind": "/subtitle"
      }
    },
    {
      "id": "g_tabs",
      "type": "Tabs",
      "labels": "Overview,Sources",
      "children": [
        "tab_a",
        "tab_b"
      ]
    },
    {
      "id": "modal_body",
      "type": "Text",
      "variant": "body",
      "text": {
        "$bind": "/notice_ok"
      }
    },
    {
      "id": "g_modal",
      "type": "Modal",
      "title": "Confirm deploy",
      "children": [
        "modal_body"
      ],
      "open": {
        "$bind": "/modal_open"
      }
    },
    {
      "id": "g_bar",
      "type": "BarChart",
      "title": "Tokens by stage",
      "data": {
        "$bind": "/tokens_by_stage"
      },
      "xKey": "stage",
      "yKey": "tokens"
    },
    {
      "id": "g_spark",
      "type": "Sparkline",
      "data": {
        "$bind": "/trend"
      },
      "tone": "good"
    },
    {
      "id": "g_stat",
      "type": "StatTile",
      "label": "p95 latency",
      "value": {
        "$bind": "/p95_latency"
      },
      "unit": " ms",
      "delta": {
        "$bind": "/p95_delta"
      },
      "tone": "good"
    },
    {
      "id": "g_progress",
      "type": "ProgressBar",
      "value": {
        "$bind": "/progress_value"
      },
      "max": 100,
      "tone": "good"
    },
    {
      "id": "g_timeline",
      "type": "Timeline",
      "title": "Run trace",
      "events": {
        "$bind": "/run_events"
      }
    },
    {
      "id": "g_table",
      "type": "DataTable",
      "columns": "Source,Status,Tokens",
      "rows": {
        "$bind": "/source_rows"
      },
      "sortable": true,
      "filterKey": "Source"
    },
    {
      "id": "g_chart_row",
      "type": "Row",
      "align": "stretch",
      "justify": "spaceBetween",
      "children": [
        "g_bar",
        "g_spark"
      ]
    },
    {
      "id": "g_kpi_row",
      "type": "Row",
      "align": "stretch",
      "justify": "spaceBetween",
      "children": [
        "g_stat",
        "g_progress"
      ]
    },
    {
      "id": "g_button",
      "type": "Button",
      "label": "Re-run",
      "onPress": {
        "action": "rerun"
      }
    },
    {
      "id": "g_approval",
      "type": "ApprovalCard",
      "summary": {
        "$bind": "/approval_summary"
      },
      "params": {
        "$bind": "/approval_params"
      },
      "confirm": {
        "action": "approve",
        "args": {
          "$bind": "/approval_params"
        }
      },
      "reject": {
        "action": "reject"
      }
    },
    {
      "id": "g_ev_corroborated",
      "type": "EvidenceTile",
      "label": "London",
      "value": {
        "$bind": "/claim_corroborated"
      },
      "confidence": "corroborated",
      "sources": {
        "$bind": "/sources_corroborated"
      },
      "fallback": "StatTile"
    },
    {
      "id": "g_ev_single",
      "type": "EvidenceTile",
      "label": "Berlin (city proper)",
      "value": {
        "$bind": "/claim_single"
      },
      "confidence": "single-source",
      "sources": {
        "$bind": "/sources_single"
      },
      "fallback": "StatTile"
    },
    {
      "id": "g_ev_disputed",
      "type": "EvidenceTile",
      "label": "Berlin (after retry)",
      "value": {
        "$bind": "/claim_disputed"
      },
      "confidence": "disputed",
      "sources": {
        "$bind": "/sources_disputed"
      },
      "dissent": {
        "$bind": "/dissent_disputed"
      },
      "fallback": "StatTile"
    },
    {
      "id": "g_ev_unsupported",
      "type": "EvidenceTile",
      "label": "Licence risk",
      "value": {
        "$bind": "/claim_unsupported"
      },
      "confidence": "unsupported",
      "sources": {
        "$bind": "/sources_none"
      },
      "fallback": "StatTile"
    },
    {
      "id": "g_ev_row",
      "type": "Row",
      "align": "stretch",
      "justify": "spaceBetween",
      "children": [
        "g_ev_corroborated",
        "g_ev_single",
        "g_ev_disputed",
        "g_ev_unsupported"
      ]
    },
    {
      "id": "sec_layout",
      "type": "Card",
      "title": "Layout",
      "children": [
        "g_row",
        "g_col",
        "g_list",
        "g_card",
        "g_divider"
      ]
    },
    {
      "id": "sec_content",
      "type": "Card",
      "title": "Content",
      "children": [
        "g_heading",
        "g_body",
        "g_image",
        "g_notice"
      ]
    },
    {
      "id": "sec_input",
      "type": "Card",
      "title": "Input",
      "children": [
        "g_textfield",
        "g_checkbox",
        "g_slider",
        "g_choice",
        "g_datetime"
      ]
    },
    {
      "id": "sec_navigation",
      "type": "Card",
      "title": "Navigation",
      "children": [
        "g_tabs",
        "g_modal"
      ]
    },
    {
      "id": "sec_charts_and_data",
      "type": "Card",
      "title": "Charts and data",
      "children": [
        "g_chart_row",
        "g_kpi_row",
        "g_timeline",
        "g_table"
      ]
    },
    {
      "id": "sec_action",
      "type": "Card",
      "title": "Action",
      "children": [
        "g_button",
        "g_approval"
      ]
    },
    {
      "id": "sec_provenance_(session_14)",
      "type": "Card",
      "title": "Provenance (Session 14)",
      "children": [
        "g_ev_row"
      ]
    }
  ],
  "dataModel": {
    "title": "The trusted catalog, drawn",
    "subtitle": "Every component the agent may name, rendered by the real client",
    "body": "Structure and data travel apart. Nothing on this page was authored as markup.",
    "notice_ok": "All 24 component types rendered from one validated surface.",
    "notice_warn": "2 of 3 sources loaded; one request timed out.",
    "query": "asyncio best practices",
    "only_peer_reviewed": true,
    "max_sources": 6,
    "model_options": [
      "gemini-3.6-flash",
      "gemini-3.1-pro",
      "ollama/phi4"
    ],
    "model_choice": "gemini-3.6-flash",
    "run_after": "2026-07-27T09:00",
    "modal_open": false,
    "tokens_by_stage": [
      {
